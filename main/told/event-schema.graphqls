scalar Instant

type Query {
  getEvent(eventId: ID!): EventOut
  getPublicEvents(filter: EventFilter, page: Int = 0, size: Int = 12, sort: [EventSort!]): EventConnection!
  getUserEvents(scope: EventScope! = PUBLIC, filter: EventFilter, page: Int = 0, size: Int = 12, sort: [EventSort!], search: String): EventConnection!
  getActiveEvents(filter: EventFilter, sort: [EventSort!]): [ActiveEventInfo]!
  searchUserEventsByUsername(username: String!, page: Int = 0, size: Int = 12, dateFilterEnum: DateFilterEnum = UPCOMING): UserEventOut
  getEventDetails(eventId: ID!, extUserId: ID!): EventDetailsOut
  getBusinessUserEventIds(userId: ID!): [ID!]
  getEventInfoList(eventIds: [String!]!): [EventInfo!]!
  searchEvents(keyword: String!): [EventSummaryOut!]!
  getEventAnalysisList(from: Instant, to: Instant, genres: [String]): [EventAnalysisOut]!
  getSignedInUserEventDetail(eventId: ID!): EventOutDashboard
  getUpcomingEventsWithTicketInfo: [EventWithTicketOut!]!
  getNewsRelatedEventsWithTicketInfo(newsId: ID!): [EventWithTicketOut!]!

  getEventInfo(eventId: String!): EventSummaryOut!  
}

type EventAnalysisOut @key(fields: "eventId"){
    eventId: ID!
    name: String
    startDate: String
    endDate: String
    imageUrl: String
    maxImagePixel: Int
    eventStatus: EventStatus
    filterFrom: Instant
    filterTo: Instant
}

enum EventScope {
    PUBLIC
    OWNED
    PARTICIPATING
}

input EventFilter {
    date: DateFilterEnum = ALL
    genres: [String!]
    onlyVisible: Boolean
}

enum EventSortField { START_DATE, CREATED_AT, NAME }
input EventSort { field: EventSortField!, dir: SortDirection! }
enum SortDirection { ASC, DESC }

type EventConnection {
    totalCount: Int!
    pageInfo: PageInfo!
    nodes: [EventSummaryOut!]!
}

type PageInfo { page: Int!, size: Int!, hasNextPage: Boolean! }

type EventSummaryOut @key(fields: "eventId"){
  eventId: ID!
  description: String
  ownerUserIds: ID!
  venueUserId: ID
  addressId: ID
  name: String
  startDate: String
  endDate: String
  imageUrl: String
  maxImagePixel: Int
  isVisible: Boolean
  eventStatus: EventStatus
}

type EventWithTicketOut @key(fields: "eventId"){
  eventId: ID!
  name: String!
  startDate: Instant!
  endDate: Instant!
  imageUrl: String
  maxImagePixel: Int
  ownerUserIds: ID!
  venueUserId: ID
  addressId: ID
}


type EventInfo {
  eventId: String!
  eventName: String!
  startDate: Instant!
  endDate: Instant!
  imageId: String
}

type EventDetailsOut {
    eventId: ID!
    startDate: String
    endDate: String
    ownerBusinessUserId: ID
    isEventOwner: Boolean
}

type EventOut @key(fields: "eventId") {
  eventId: ID!
  name: String
  description: String
  startDate: String
  endDate: String
  imageUrl: String
  maxImagePixel: Int

  
  genres: [String]
  otherArtists: [String]

  ownerUserIds: ID!
  venueUserId: ID
  artistIds: ID
  addressId: ID

}

type ActiveEventInfo @key(fields: "eventId") {
  eventId: ID!
  ownerUserIds: ID!
  venueUserId: ID
  addressId: ID
}

type EventOutDashboard @key(fields: "eventId") {
  eventId: ID!
  name: String
  description: String
  genres: [String]
  otherArtists: [String]
  startDate: String
  endDate: String
  imageUrl: String
  eventStatus: EventStatus
  ownerUserIds: ID!
  venueUserId: ID
  artistIds: ID
  addressId: ID
  maxImagePixel: Int
  isVisible: Boolean
}


type UserEventOut @key(fields: "username") {
  username: String!
  events: [EventSummaryOut]
}


type SearchOut @key(fields: "keyword") @extends{
  keyword: String! @external
  events: [EventSummaryOut!]!
}


enum DateFilterEnum {
    UPCOMING
    PREVIOUS
    ALL
}

enum EventStatus {
    DRAFT
    WAIT_FOR_APPROVAL
    APPROVED
    REJECTED
}