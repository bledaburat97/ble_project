scalar Instant

type Query {
  event(eventId: ID!): Event
  events(scope: EventScope! = PUBLIC, filter: EventFilter, page: Int = 0, size: Int = 12, sort: [EventSort!], search: String): EventConnection!
  activeEvents(filter: EventFilter, sort: [EventSort!]): [Event!]!
  eventInfoList(eventIds: [ID!]!): [Event!]!
  searchEvents(keyword: String!): [Event!]!
  
  userEventsByUsername(username: String!, page: Int = 0, size: Int = 12, dateFilterEnum: DateFilterEnum = UPCOMING): UserEventOut
  eventDetails(eventId: ID!, extUserId: ID!): EventDetailsOut
  businessUserEventIds(userId: ID!): [ID!]!
  eventAnalysisList(from: Instant, to: Instant, genres: [String!]): [EventAnalysisOut!]!
  getSignedInUserEventDetail(eventId: ID!): EventOutDashboard!
  getUpcomingEventsWithTicketInfo: [EventWithTicketOut!]!
  getNewsRelatedEventsWithTicketInfo(newsId: ID!): [EventWithTicketOut!]!
  
}

enum EventScope {
  PUBLIC
  OWNED
  PARTICIPATING
}

input EventFilter {
  date: DateFilterEnum = ALL
  genres: [String!]
  onlyVisible: Boolean
}

enum EventSortField { START_DATE, CREATED_AT, NAME }
input EventSort { field: EventSortField!, dir: SortDirection! }
enum SortDirection { ASC, DESC }

type EventConnection {
  totalCount: Int!
  pageInfo: PageInfo!
  nodes: [Event!]!
}

type PageInfo { page: Int!, size: Int!, hasNextPage: Boolean! }

type Event @key(fields: "eventId") {
  eventId: ID!

  name: String
  description: String
  startDate: Instant
  endDate: Instant
  imageUrl: String
  maxImagePixel: Int
  isVisible: Boolean
  eventStatus: EventStatus

  # IMPORTANT: these must be filled by event-service for other services to resolve
  ownerUserIds: [ID!]!
  venueUserId: ID
  addressId: ID
  artistIds: [ID!]!

  # denormalized snapshot from event DB (if you keep them)
  locality: String
  administrativeArea: String
  country: String

  genres: [String!]
  otherArtists: [String!]

  # resolved in user service
  organizers: [UserSummaryOut!]
  artists: [UserSummaryOut!]
  venue: VenueUserSummaryOut
  address: AddressOut

  # resolved in ticket service
  tickets: [TicketOut!]
  hasTicket: Boolean
}

type EventDetailsOut {
  eventId: ID!
  startDate: Instant
  endDate: Instant
  ownerBusinessUserId: ID
  isEventOwner: Boolean
}

type UserEventOut @key(fields: "username") {
  username: String!
  displayName: String
  userImageUrl: String
  events: [Event!]
  maxImagePixel: Int
}

type SearchOut @key(fields: "keyword") @extends {
  keyword: String! @external
  events: [Event!]!
}

type EventWithTicketOut @key(fields: "eventId") {
  eventId: ID!
  name: String!
  startDate: Instant!
  endDate: Instant!
  imageUrl: String
  maxImagePixel: Int
  ownerUserIds: [ID!]!
  venueUserId: ID
  addressId: ID
  locality: String
  administrativeArea: String
  country: String
  organizers: [UserSummaryOut!]
  ticket: TicketOut
}

type EventAnalysisOut @key(fields: "eventId") {
  eventId: ID!
  name: String
  startDate: Instant
  endDate: Instant
  imageUrl: String
  maxImagePixel: Int
  eventStatus: EventStatus
  filterFrom: Instant
  filterTo: Instant
  soldTickets: [SoldTicketSummaryOut!]
}

type EventOutDashboard @key(fields: "eventId") {
  eventId: ID!
  name: String
  description: String
  genres: [String]
  otherArtists: [String]
  startDate: Instant
  endDate: Instant
  imageUrl: String
  maxImagePixel: Int

  # federation inputs
  ownerUserIds: [ID!]!
  venueUserId: ID
  artistIds: [ID!]
  addressId: ID

  # resolved by other services (user / ticket)
  organizers: [UserSummaryOut!]
  artists: [UserSummaryOut!]
  venue: VenueUserSummaryOut
  address: AddressOut
  tickets: [TicketOutDashboard!]

  eventStatus: EventStatus
  isVisible: Boolean
}

enum DateFilterEnum {
  UPCOMING
  PREVIOUS
  ALL
}

enum EventStatus {
  DRAFT
  WAIT_FOR_APPROVAL
  APPROVED
  REJECTED
}
