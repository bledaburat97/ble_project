    private String status;
    private String walleeIframeUrl;

    public ReservationStatusOut(String status, String walleeIframeUrl) {
        this.status = status;
        this.walleeIframeUrl = walleeIframeUrl;
    }

    // Getters and setters
}

// SagaState enum'ına eklemeler
public enum SagaState {
    ORDER_INITIATED, // İlk talep alındı
    TICKET_DECREASED, // Bilet stoğu düşürüldü
    TICKET_DECREASE_FAILED, // Bilet stoğu düşürme başarısız
    PAYMENT_INITIATED, // Ödeme başlatıldı, iframe URL'i hazır
    PAYMENT_COMPLETED, // Ödeme başarılı
    PAYMENT_FAILED, // Ödeme başarısız (Wallee'den veya zaman aşımı ile)
    USER_TICKET_RECORDED, // Kullanıcıya biletler kaydedildi
    USER_TICKET_RECORD_FAILED, // Kullanıcıya bilet kaydı başarısız
    COMPLETED, // Tüm Saga başarıyla tamamlandı
    FAILED, // Saga başarısızlıkla sonuçlandı (tazminatlar tamamlandı)
    CHECKER_FAILED // Checker tarafından ele alınamayan bir durum
}