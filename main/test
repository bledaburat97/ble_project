// YENİ: Ödeme durumunu polling ile almak için fonksiyon
const pollingIntervalRef = useRef<NodeJS.Timeout>();

const startPollingForPaymentStatus = (reservationId: string) => {
    // Önceki polling varsa temizle
    if (pollingIntervalRef.current) {
        clearInterval(pollingIntervalRef.current);
    }

    // İlk sorguyu hemen yap
    checkReservationStatus(reservationId);

    // Belirli aralıklarla sorgula
    pollingIntervalRef.current = setInterval(() => {
        checkReservationStatus(reservationId);
    }, 5000); // Örneğin her 5 saniyede bir sorgula
};

const stopPollingForPaymentStatus = () => {
    if (pollingIntervalRef.current) {
        clearInterval(pollingIntervalRef.current);
        pollingIntervalRef.current = undefined;
    }
};

const checkReservationStatus = async (reservationId: string) => {
    try {
        const { data } = await getReservationStatus({ variables: { reservationId } });

        if (data?.getReservationStatus) {
            const { status } = data.getReservationStatus;

            switch (status) {
                case "PAYMENT_INITIATED": // Backend'den gelen yeni durum
                    // Polling devam etsin

                    if (walleeIframeUrl) {
                        setIframeCheckout({ iframeUrl: walleeIframeUrl, paymentMethodConfigurationId: "..." }); // PaymentMethodConfigurationId'yi backend'den de almanız gerekebilir
                        stopPollingForPaymentStatus(); // Iframe URL'ini aldık, polling'i durdur
                        setInitPaymentLoading(false); // Yükleme durumunu kapat
                    }
                    break;
                case "COMPLETED": // Ödeme başarılı ve biletler kaydedildi
                    stopPollingForPaymentStatus();
                    setIsPaymentSuccess(true);
                    //TODO: successUrl'i yükle. 
                    // TODO: veya böyle yapılabilir mi düşün: Sayfayı success=true ile yenilemek yerine, doğrudan durumu güncelle
                    // window.history.replaceState({}, document.title, url.pathname); // URL'den success parametresini kaldır
                    message.success(t("ticket.success")); // Başarı mesajı
                    break;
                case "FAILED": // Ödeme veya bilet kaydı başarısız
                case "CANCELLED": // Ödeme iptal edildi (örneğin zaman aşımı)
                    stopPollingForPaymentStatus();
                    message.error(t("ticket.request_failed"));
                    setInitPaymentLoading(false); // Yükleme durumunu kapat
                    //TODO: failed url'i yükle. 

                    break;
                // Diğer ara durumlar için polling devam etmeli
                case "ORDER_INITIATED":
                case "TICKET_DECREASED":
                    // Polling devam etsin
                    break;
                default:
                    console.warn("Unknown reservation status:", status);
                    break;
            }
        }
    } catch (error) {
        console.error("Error polling reservation status:", error);
        // Hata durumunda polling'i durdurabilir veya yeniden deneme stratejisi uygulayabiliriz.
