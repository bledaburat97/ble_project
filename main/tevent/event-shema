scalar Instant

type Query {
  getEventById(eventId: ID!): EventOut!
  getEvents(scope: EventScope = PUBLIC, filter: EventFilter, page: Int = 0, size: Int = 12, sort: [EventSort!], search: String): EventConnection!
  getEventsByIds(eventIds: [String!]!): [EventOut!]!

  searchUserEventsByUsername(username: String!, page: Int = 0, size: Int = 12, dateFilterEnum: DateFilterEnum = UPCOMING): UserEventOut
  getEventDetails(eventId: ID!, extUserId: ID!): EventDetailsOut
  getBusinessUserEventIds(userId: ID!): [ID!]
  getEventAnalysisList(from: Instant, to: Instant, genres: [String]): [EventAnalysisOut]!
  getSignedInUserEventDetail(eventId: ID!): EventOutDashboard
  getUpcomingEventsWithTicketInfo: [EventWithTicketOut!]!
  getNewsRelatedEventsWithTicketInfo(newsId: ID!): [EventWithTicketOut!]!
}

type EventConnection {
  totalCount: Int!
  pageInfo: PageInfo!
  nodes: [EventOut!]!
}

type PageInfo {
  page: Int!
  size: Int!
  hasNextPage: Boolean!
}

enum EventScope {
  PUBLIC
  OWNED
  PARTICIPATING
}

enum DateFilterEnum {
  UPCOMING
  PREVIOUS
  ALL
}

input EventFilter {
  dateFilter: DateFilterEnum = ALL
  genres: [String!]
  onlyVisible: Boolean
}

enum SortDirection {
  ASC
  DESC
}

enum EventSortField {
  START_DATE
  CREATED_AT
  NAME
}

input EventSort {
  field: EventSortField!
  dir: SortDirection! = ASC
}

enum EventStatus {
  DRAFT
  WAIT_FOR_APPROVAL
  APPROVED
  REJECTED
}

type EventOut @key(fields: "eventId") {
  eventId: ID!

  name: String
  description: String

  startDate: Instant
  endDate: Instant

  imageUrl: String
  maxImagePixel: Int

  isVisible: Boolean
  eventStatus: EventStatus
  hasTicket: Boolean

  ownerUserIds: [String!]!
  venueUserId: String
  addressId: String
  artistIds: [String]

  genres: [String]
  otherArtists: [String]

//Bunlar burada olmayacak
  organizers: [UserSummaryOut!]
  address: AddressOut
  artists: [UserSummaryOut!]
  venue: VenueUserSummaryOut
  tickets: [TicketOut!]
}

type EventAnalysisOut @key(fields: "eventId"){
  eventId: ID!
  name: String
  startDate: Instant
  endDate: Instant
  imageUrl: String
  maxImagePixel: Int
  eventStatus: EventStatus
  filterFrom: Instant
  filterTo: Instant
}

type EventWithTicketOut @key(fields: "eventId"){
  eventId: ID!
  name: String!
  startDate: Instant!
  endDate: Instant!
  imageUrl: String
  maxImagePixel: Int
  ownerUserIds: [String!]!
  venueUserId: String
  addressId: String
}

type EventDetailsOut {
  eventId: ID!
  startDate: Instant
  endDate: Instant
  ownerBusinessUserId: String
  isEventOwner: Boolean
}

type EventOutDashboard @key(fields: "eventId") {
  eventId: ID!
  name: String
  description: String
  genres: [String]
  otherArtists: [String]
  startDate: Instant
  endDate: Instant
  imageUrl: String
  eventStatus: EventStatus
  ownerUserIds: [String!]!
  venueUserId: String
  addressId: String
  artistIds: [String]
  maxImagePixel: Int
  isVisible: Boolean
}

type UserEventOut @key(fields: "username") {
  username: String!
  events: [EventOut]
}

type SearchOut @key(fields: "keyword") @extends{
  keyword: String! @external
  events: [EventOut!]!
}